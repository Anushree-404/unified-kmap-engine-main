# ── Application ──────────────────────────────────────────────────────────────
APP_NAME=AGROVA AI Backend
APP_VERSION=1.0.0
DEBUG=false

# ── Server ────────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# ── API keys (server-side only — never expose these to the browser) ───────────
GOOGLE_MAPS_API_KEY=your_google_maps_server_api_key
OPENWEATHER_API_KEY=your_openweather_api_key
OPENAI_API_KEY=your_openai_api_key

# ── Database (optional) ───────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/agrova
