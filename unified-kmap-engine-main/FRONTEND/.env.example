# Google Maps API key (browser-side, used by the KMap feature)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_BROWSER_KEY=your_google_maps_browser_api_key_here

# Google Maps connector tracking ID (provided by the Lovable connector gateway)
VITE_LOVABLE_CONNECTOR_GOOGLE_MAPS_TRACKING_ID=your_lovable_connector_tracking_id_here

# Backend API base URL — update this when deploying a separate Python/FastAPI backend
# Leave empty or unset to use TanStack Start server functions (default / recommended)
VITE_API_BASE_URL=http://localhost:8000
